PORT=5000

# Environment mode (development | production)
NODE_ENV=development
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/docmind?retryWrites=true&w=majority

JWT_SECRET=your_super_secret_jwt_key_generate_this_random_string
JWT_EXPIRE=7d

# Groq API 
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=

# Upload directory (relative path)
UPLOAD_DIR=./uploads
# Size of each text chunk in characters
CHUNK_SIZE=800

# Overlap between chunks in characters
OVERLAP=150
# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
# Rate limiting window in minutes
RATE_LIMIT_WINDOW=15

# Maximum requests per window
RATE_LIMIT_MAX=100

LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173,https://yourdomain.com
MONGOOSE_DEBUG=false