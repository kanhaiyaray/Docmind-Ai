# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Client URL (used in verification / reset emails)
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/docmind?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_generate_this_random_string
JWT_REFRESH_SECRET=your_super_secret_refresh_key_generate_this_too
JWT_EXPIRE=7d

# Resend Email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_CHAT_MODEL=gpt-4-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIMENSION=1536

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Chunking
CHUNK_SIZE=800
OVERLAP=150

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug
MONGOOSE_DEBUG=false
