# Server Configuration
PORT=5000

# Cors Origins 
# Frontend URL (for CORS)
CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=https://yourdomain.com

# Environment mode (development | production)
NODE_ENV=development
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/docmind?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_generate_this_random_string
JWT_EXPIRE=7d

# RESEND EMAIL CONFIGURATION
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com

# Groq API 
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=

# Upload directory (relative path)
UPLOAD_DIR=./uploads
# Size of each text chunk in characters
CHUNK_SIZE=800

# Overlap between chunks in characters
OVERLAP=150

# Rate limiting window in minutes
RATE_LIMIT_WINDOW=15

# Maximum requests per window
RATE_LIMIT_MAX=100

LOG_LEVEL=debug

MONGOOSE_DEBUG=false