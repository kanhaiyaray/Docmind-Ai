# ============================================
# API CONFIGURATION
# ============================================

# Backend API URL
# Development: http://localhost:5000/api
# Production: https://your-backend-domain.com/api
VITE_API_URL=http://localhost:5000/api

# ============================================
# APP CONFIGURATION
# ============================================

# App name (used in UI)
VITE_APP_NAME=DocMind

# App description
VITE_APP_DESCRIPTION=AI Document Intelligence Platform

# ============================================
# FEATURE FLAGS (Enable/disable features)
# ============================================

# Enable/disable features (true | false)
VITE_ENABLE_DOCUMENT_COMPARISON=true
VITE_ENABLE_QUIZ_GENERATOR=true
VITE_ENABLE_FLASHCARDS=true
VITE_ENABLE_STREAMING_RESPONSES=true
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_PDF_ANNOTATIONS=true

# ============================================
# ANALYTICS (Optional)
# ============================================

# Google Analytics ID (optional)
# VITE_GA_ID=G-XXXXXXXXXX

# ============================================
# DEPLOYMENT CONFIGURATION
# ============================================

# Base URL for deployment
VITE_BASE_URL=/

# Enable source maps in production
VITE_GENERATE_SOURCEMAP=true

# ============================================
# UPLOAD CONFIGURATION
# ============================================

# Maximum file size in MB
VITE_MAX_FILE_SIZE_MB=10

# Allowed file types
VITE_ALLOWED_FILE_TYPES=.pdf

# ============================================
# UI CONFIGURATION
# ============================================

# Default theme (light | dark | system)
VITE_DEFAULT_THEME=light

# Enable animations
VITE_ENABLE_ANIMATIONS=true

# ============================================
# DEBUG CONFIGURATION
# ============================================

# Enable debug mode
VITE_DEBUG_MODE=false

# Enable logging
VITE_ENABLE_LOGGING=true